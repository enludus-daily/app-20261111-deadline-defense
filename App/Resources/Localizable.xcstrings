    "用事を1行で入れると、敵になって城（今日のあなた）へ向かいます。城に近いほど、締め切りが近い。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each task becomes a foe walking toward your castle — that's you, today. The closer it gets, the sooner it's due."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "用事を1行で入れると、敵になって城（今日のあなた）へ向かいます。城に近いほど、締め切りが近い。"
          }
        }
      }
    },
    "用事・締め切り・戦果はこの iPhone の中にだけ保存します。外に送らず、アカウントもありません。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tasks, deadlines, and reports are saved only on this iPhone. Nothing is sent anywhere, and there's no account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "用事・締め切り・戦果はこの iPhone の中にだけ保存します。外に送らず、アカウントもありません。"
          }
        }
      }
    },
    "用事・締め切り・敵・砲台・分ける・通知・今日の戦果は、ずっと無料です。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tasks, deadlines, foes, towers, splitting, reminders, and today's report are free forever."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "用事・締め切り・敵・砲台・分ける・通知・今日の戦果は、ずっと無料です。"
          }
        }
      }
    },
